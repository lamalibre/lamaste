{
  "version": 1,
  "meta": {
    "number": 7,
    "name": "Certificate Renewal",
    "suite": "e2e",
    "description": "07 — Certificate Renewal",
    "deps": [],
    "requires": ["curl", "jq"]
  },
  "env": {},
  "constants": {},
  "cleanup": [],
  "sections": [
    {
      "id": "pre-flight-check-onboarding-is-complete",
      "label": "Pre-flight: check onboarding is complete",
      "steps": [
        {
          "id": "step-0",
          "label": "GET /api/onboarding/status",
          "target": "host",
          "op": {
            "type": "api",
            "method": "GET",
            "path": "onboarding/status"
          },
          "capture": [
            {
              "variable": "ONBOARDING_STATUS",
              "from": {
                "kind": "jq",
                "expression": ".status"
              }
            }
          ]
        }
      ],
      "when": {
        "kind": "var_eq",
        "variable": "ONBOARDING_STATUS",
        "value": "COMPLETED"
      },
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Pre-flight: check onboarding is complete\"\n# ---------------------------------------------------------------------------\n\nONBOARDING_STATUS=$(api_get \"onboarding/status\" | jq -r '.status' 2>/dev/null || echo \"unknown\")\nif [ \"$ONBOARDING_STATUS\" != \"COMPLETED\" ]; then\n  log_skip \"Skipping certificate tests — onboarding not complete\"\n  end_test\n  exit $?\nfi"
    },
    {
      "id": "list-certificates",
      "label": "List certificates",
      "steps": [
        {
          "id": "step-1",
          "label": "GET /api/certs",
          "target": "host",
          "op": {
            "type": "api",
            "method": "GET",
            "path": "certs"
          },
          "capture": [
            {
              "variable": "CERTS_RESPONSE",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-2",
          "label": "Set CERT_COUNT",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "echo \"$CERTS_RESPONSE\" | jq '.certs | length' 2>/dev/null || echo \"0\""
          },
          "capture": [
            {
              "variable": "CERT_COUNT",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-3",
          "label": "GET /api/certs returns $CERT_COUNT certificates",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "GET /api/certs returns $CERT_COUNT certificates"
          }
        },
        {
          "id": "step-4",
          "label": "No certificates listed (this is expected if certbot has not issued any yet)",
          "target": "local",
          "op": {
            "type": "log",
            "level": "info",
            "message": "No certificates listed (this is expected if certbot has not issued any yet)"
          }
        },
        {
          "id": "step-5",
          "label": "Set FIRST_CERT",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "echo \"$CERTS_RESPONSE\" | jq '.certs[0]' 2>/dev/null || echo \"{}\""
          },
          "capture": [
            {
              "variable": "FIRST_CERT",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-6",
          "label": "Certificate has a type field",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field_not_empty",
              "source": {
                "kind": "var",
                "name": "FIRST_CERT"
              },
              "path": ".type",
              "message": "Certificate has a type field"
            }
          }
        },
        {
          "id": "step-7",
          "label": "Certificate has a domain field",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field_not_empty",
              "source": {
                "kind": "var",
                "name": "FIRST_CERT"
              },
              "path": ".domain",
              "message": "Certificate has a domain field"
            }
          }
        },
        {
          "id": "step-8",
          "label": "Certificate has an expiresAt field",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field_not_empty",
              "source": {
                "kind": "var",
                "name": "FIRST_CERT"
              },
              "path": ".expiresAt",
              "message": "Certificate has an expiresAt field"
            }
          }
        },
        {
          "id": "step-9",
          "label": "Set DAYS",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "echo \"$FIRST_CERT\" | jq '.daysUntilExpiry' 2>/dev/null || echo \"null\""
          },
          "capture": [
            {
              "variable": "DAYS",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-10",
          "label": "Certificate has numeric daysUntilExpiry: $DAYS",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "Certificate has numeric daysUntilExpiry: $DAYS"
          },
          "when": {
            "kind": "and",
            "conditions": [
              {
                "kind": "var_not_eq",
                "variable": "DAYS",
                "value": "null"
              },
              {
                "kind": "var_not_eq",
                "variable": "DAYS",
                "value": ""
              }
            ]
          }
        },
        {
          "id": "step-11",
          "label": "Certificate daysUntilExpiry is missing or null",
          "target": "local",
          "op": {
            "type": "log",
            "level": "fail",
            "message": "Certificate daysUntilExpiry is missing or null"
          },
          "when": {
            "kind": "or",
            "conditions": [
              {
                "kind": "var_eq",
                "variable": "DAYS",
                "value": "null"
              },
              {
                "kind": "var_eq",
                "variable": "DAYS",
                "value": ""
              }
            ]
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"List certificates\"\n# ---------------------------------------------------------------------------\n\nCERTS_RESPONSE=$(api_get \"certs\")\nCERT_COUNT=$(echo \"$CERTS_RESPONSE\" | jq '.certs | length' 2>/dev/null || echo \"0\")\n\nif [ \"$CERT_COUNT\" -gt 0 ]; then\n  log_pass \"GET /api/certs returns $CERT_COUNT certificates\"\nelse\n  log_info \"No certificates listed (this is expected if certbot has not issued any yet)\"\nfi\n\n# Verify certificate fields\nif [ \"$CERT_COUNT\" -gt 0 ]; then\n  FIRST_CERT=$(echo \"$CERTS_RESPONSE\" | jq '.certs[0]' 2>/dev/null || echo \"{}\")\n  assert_json_field_not_empty \"$FIRST_CERT\" '.type' \"Certificate has a type field\" || true\n  assert_json_field_not_empty \"$FIRST_CERT\" '.domain' \"Certificate has a domain field\" || true\n  assert_json_field_not_empty \"$FIRST_CERT\" '.expiresAt' \"Certificate has an expiresAt field\" || true\n\n  # Check daysUntilExpiry is a number\n  DAYS=$(echo \"$FIRST_CERT\" | jq '.daysUntilExpiry' 2>/dev/null || echo \"null\")\n  if [ \"$DAYS\" != \"null\" ] && [ \"$DAYS\" != \"\" ]; then\n    log_pass \"Certificate has numeric daysUntilExpiry: $DAYS\"\n  else\n    log_fail \"Certificate daysUntilExpiry is missing or null\"\n  fi\nfi"
    },
    {
      "id": "force-renew-certificate",
      "label": "Force renew certificate",
      "steps": [
        {
          "id": "step-12",
          "label": "GET /api/onboarding/status",
          "target": "host",
          "op": {
            "type": "api",
            "method": "GET",
            "path": "onboarding/status"
          },
          "capture": [
            {
              "variable": "DOMAIN",
              "from": {
                "kind": "jq",
                "expression": ".domain"
              }
            }
          ]
        },
        {
          "id": "step-14",
          "label": "Set CALLS_BEFORE_RENEW",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo cat /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | wc -l | tr -d ' '"
          },
          "capture": [
            {
              "variable": "CALLS_BEFORE_RENEW",
              "from": {
                "kind": "body"
              }
            }
          ],
          "when": {
            "kind": "and",
            "conditions": [
              {
                "kind": "var_not_empty",
                "variable": "DOMAIN"
              },
              {
                "kind": "var_not_eq",
                "variable": "DOMAIN",
                "value": "null"
              }
            ]
          }
        },
        {
          "id": "step-15",
          "label": "POST /api/certs/$RENEW_DOMAIN/renew",
          "target": "host",
          "op": {
            "type": "api",
            "method": "POST",
            "path": "certs/$RENEW_DOMAIN/renew"
          },
          "capture": [
            {
              "variable": "RENEW_RESPONSE",
              "from": {
                "kind": "body"
              }
            }
          ],
          "when": {
            "kind": "and",
            "conditions": [
              {
                "kind": "var_not_empty",
                "variable": "DOMAIN"
              },
              {
                "kind": "var_not_eq",
                "variable": "DOMAIN",
                "value": "null"
              }
            ]
          }
        },
        {
          "id": "step-16",
          "label": "Extract RENEW_OK",
          "target": "local",
          "op": {
            "type": "set",
            "variable": "RENEW_OK",
            "from": {
              "kind": "jq",
              "input": {
                "kind": "var",
                "name": "RENEW_RESPONSE"
              },
              "expression": ".ok"
            }
          },
          "when": {
            "kind": "and",
            "conditions": [
              {
                "kind": "var_not_empty",
                "variable": "DOMAIN"
              },
              {
                "kind": "var_not_eq",
                "variable": "DOMAIN",
                "value": "null"
              }
            ]
          }
        },
        {
          "id": "step-17",
          "label": "Certificate renewal succeeded for $RENEW_DOMAIN",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "Certificate renewal succeeded for $RENEW_DOMAIN"
          },
          "when": {
            "kind": "var_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-18",
          "label": "Renewal response contains correct domain",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "var",
                "name": "RENEW_RESPONSE"
              },
              "path": ".domain",
              "expected": {
                "kind": "var",
                "name": "RENEW_DOMAIN"
              },
              "message": "Renewal response contains correct domain"
            }
          },
          "when": {
            "kind": "var_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-19",
          "label": "Renewal response contains new expiry",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field_not_empty",
              "source": {
                "kind": "var",
                "name": "RENEW_RESPONSE"
              },
              "path": ".newExpiry",
              "message": "Renewal response contains new expiry"
            }
          },
          "when": {
            "kind": "var_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-20",
          "label": "Set RENEW_CALL",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo tail -n +$((CALLS_BEFORE_RENEW + 1)) /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | grep ' renew ' | tail -1 || true"
          },
          "capture": [
            {
              "variable": "RENEW_CALL",
              "from": {
                "kind": "body"
              }
            }
          ],
          "when": {
            "kind": "var_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-21",
          "label": "certbot ran with the wrapper's renew argv (--no-random-sleep-on-renew)",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "var",
                "name": "RENEW_CALL"
              },
              "substring": {
                "kind": "expr",
                "template": "renew --cert-name ${RENEW_DOMAIN} --force-renewal --no-random-sleep-on-renew --non-interactive"
              },
              "message": "certbot ran with the wrapper's renew argv (--no-random-sleep-on-renew)"
            }
          },
          "when": {
            "kind": "var_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-22",
          "label": "Extract RENEW_ERROR",
          "target": "local",
          "op": {
            "type": "set",
            "variable": "RENEW_ERROR",
            "from": {
              "kind": "jq",
              "input": {
                "kind": "var",
                "name": "RENEW_RESPONSE"
              },
              "expression": ".error"
            }
          },
          "when": {
            "kind": "var_not_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-23",
          "label": "Certificate renewal returned: $RENEW_ERROR",
          "target": "local",
          "op": {
            "type": "log",
            "level": "info",
            "message": "Certificate renewal returned: $RENEW_ERROR"
          },
          "when": {
            "kind": "var_not_eq",
            "variable": "RENEW_OK",
            "value": "true"
          }
        },
        {
          "id": "step-24",
          "label": "No domain configured — cannot test renewal",
          "target": "local",
          "op": {
            "type": "log",
            "level": "skip",
            "message": "No domain configured — cannot test renewal"
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Force renew certificate\"\n# ---------------------------------------------------------------------------\n\nif skip_if_no_dns \"Certificate renewal requires real Let's Encrypt — skipping\"; then\n  DOMAIN=$(api_get \"onboarding/status\" | jq -r '.domain' 2>/dev/null || echo \"\")\n\n  if [ -n \"$DOMAIN\" ] && [ \"$DOMAIN\" != \"null\" ]; then\n    # Try to renew the panel cert (panel.<domain>)\n    RENEW_DOMAIN=\"panel.${DOMAIN}\"\n    CALLS_BEFORE_RENEW=$(sudo cat /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | wc -l | tr -d ' ')\n    RENEW_RESPONSE=$(api_post \"certs/$RENEW_DOMAIN/renew\")\n    RENEW_OK=$(echo \"$RENEW_RESPONSE\" | jq -r '.ok' 2>/dev/null || echo \"false\")\n\n    if [ \"$RENEW_OK\" = \"true\" ]; then\n      log_pass \"Certificate renewal succeeded for $RENEW_DOMAIN\"\n      assert_json_field \"$RENEW_RESPONSE\" '.domain' \"$RENEW_DOMAIN\" \"Renewal response contains correct domain\" || true\n      assert_json_field_not_empty \"$RENEW_RESPONSE\" '.newExpiry' \"Renewal response contains new expiry\" || true\n      # The wrapper's fixed argv: no random delay while an operator waits\n      RENEW_CALL=$(sudo tail -n +$((CALLS_BEFORE_RENEW + 1)) /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | grep ' renew ' | tail -1 || true)\n      assert_contains \"$RENEW_CALL\" \"renew --cert-name ${RENEW_DOMAIN} --force-renewal --no-random-sleep-on-renew --non-interactive\" \"certbot ran with the wrapper's renew argv (--no-random-sleep-on-renew)\" || true\n    else\n      RENEW_ERROR=$(echo \"$RENEW_RESPONSE\" | jq -r '.error' 2>/dev/null || echo \"unknown\")\n      log_info \"Certificate renewal returned: $RENEW_ERROR\"\n    fi\n  else\n    log_skip \"No domain configured — cannot test renewal\"\n  fi\nfi"
    },
    {
      "id": "renew-nonexistent-certificate",
      "label": "Renew nonexistent certificate",
      "steps": [
        {
          "id": "step-25",
          "label": "POST /api/certs/nonexistent.example.com/renew",
          "target": "host",
          "op": {
            "type": "api",
            "method": "POST",
            "path": "certs/nonexistent.example.com/renew",
            "statusOnly": true
          },
          "capture": [
            {
              "variable": "RENEW_404_STATUS",
              "from": {
                "kind": "status"
              }
            }
          ]
        },
        {
          "id": "step-26",
          "label": "Renew nonexistent cert returns HTTP $RENEW_404_STATUS",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "Renew nonexistent cert returns HTTP $RENEW_404_STATUS"
          },
          "when": {
            "kind": "or",
            "conditions": [
              {
                "kind": "var_eq",
                "variable": "RENEW_404_STATUS",
                "value": "404"
              },
              {
                "kind": "var_eq",
                "variable": "RENEW_404_STATUS",
                "value": "500"
              }
            ]
          }
        },
        {
          "id": "step-27",
          "label": "Renew nonexistent cert unexpected status: HTTP $RENEW_404_STATUS",
          "target": "local",
          "op": {
            "type": "log",
            "level": "fail",
            "message": "Renew nonexistent cert unexpected status: HTTP $RENEW_404_STATUS"
          },
          "when": {
            "kind": "and",
            "conditions": [
              {
                "kind": "var_not_eq",
                "variable": "RENEW_404_STATUS",
                "value": "404"
              },
              {
                "kind": "var_not_eq",
                "variable": "RENEW_404_STATUS",
                "value": "500"
              }
            ]
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Renew nonexistent certificate\"\n# ---------------------------------------------------------------------------\n\nif skip_if_no_dns \"Certbot test requires real infrastructure — skipping\"; then\n  RENEW_404_STATUS=$(api_post_status \"certs/nonexistent.example.com/renew\")\n  if [ \"$RENEW_404_STATUS\" = \"404\" ] || [ \"$RENEW_404_STATUS\" = \"500\" ]; then\n    log_pass \"Renew nonexistent cert returns HTTP $RENEW_404_STATUS\"\n  else\n    log_fail \"Renew nonexistent cert unexpected status: HTTP $RENEW_404_STATUS\"\n  fi\nfi"
    },
    {
      "id": "sudoers-certbot-and-certificate-reads-via-root-owned-wrappers",
      "label": "Sudoers: certbot and certificate reads via root-owned wrappers",
      "steps": [
        {
          "id": "step-28",
          "label": "Set SUDOERS_RULES",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo grep -v '^[[:space:]]*#' /etc/sudoers.d/lamaste 2>/dev/null || echo \"\""
          },
          "capture": [
            {
              "variable": "SUDOERS_RULES",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-29",
          "label": "sudoers allows the lamaste-certbot wrapper",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "var",
                "name": "SUDOERS_RULES"
              },
              "substring": {
                "kind": "literal",
                "value": "NOPASSWD: /usr/local/sbin/lamaste-certbot"
              },
              "message": "sudoers allows the lamaste-certbot wrapper"
            }
          }
        },
        {
          "id": "step-30",
          "label": "sudoers allows the lamaste-cert-info wrapper",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "var",
                "name": "SUDOERS_RULES"
              },
              "substring": {
                "kind": "literal",
                "value": "NOPASSWD: /usr/local/sbin/lamaste-cert-info"
              },
              "message": "sudoers allows the lamaste-cert-info wrapper"
            }
          }
        },
        {
          "id": "step-31",
          "label": "sudoers has no direct certbot rule",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "not_contains",
              "actual": {
                "kind": "var",
                "name": "SUDOERS_RULES"
              },
              "substring": {
                "kind": "literal",
                "value": "/usr/bin/certbot"
              },
              "message": "sudoers has no direct certbot rule"
            }
          }
        },
        {
          "id": "step-32",
          "label": "sudoers has no rule reaching into /etc/letsencrypt",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "not_contains",
              "actual": {
                "kind": "var",
                "name": "SUDOERS_RULES"
              },
              "substring": {
                "kind": "literal",
                "value": "/etc/letsencrypt"
              },
              "message": "sudoers has no rule reaching into /etc/letsencrypt"
            }
          }
        },
        {
          "id": "step-34",
          "label": "Set WRAPPER_STAT",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "stat -c '%U %G %a' \"/usr/local/sbin/${wrapper}\" 2>/dev/null || echo \"missing\""
          },
          "capture": [
            {
              "variable": "WRAPPER_STAT",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-35",
          "label": "/usr/local/sbin/${wrapper} is root-owned 0755",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "var",
                "name": "WRAPPER_STAT"
              },
              "expected": {
                "kind": "literal",
                "value": "root root 755"
              },
              "message": "/usr/local/sbin/${wrapper} is root-owned 0755"
            }
          }
        },
        {
          "id": "step-37",
          "label": "Set DIRECT_CERTBOT",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo -u lamaste sudo -n /usr/bin/certbot certificates >/dev/null 2>&1 && echo allowed || echo denied"
          },
          "capture": [
            {
              "variable": "DIRECT_CERTBOT",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-38",
          "label": "lamaste cannot run /usr/bin/certbot through sudo",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "var",
                "name": "DIRECT_CERTBOT"
              },
              "expected": {
                "kind": "literal",
                "value": "denied"
              },
              "message": "lamaste cannot run /usr/bin/certbot through sudo"
            }
          }
        },
        {
          "id": "step-39",
          "label": "GET /api/onboarding/status",
          "target": "host",
          "op": {
            "type": "api",
            "method": "GET",
            "path": "onboarding/status"
          },
          "capture": [
            {
              "variable": "WRAP_DOMAIN",
              "from": {
                "kind": "jq",
                "expression": ".domain"
              }
            }
          ]
        },
        {
          "id": "step-42",
          "label": "lamaste-certbot rejects extra arguments (exit 2)",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "var",
                "name": "EXTRA_ARG_RC"
              },
              "expected": {
                "kind": "literal",
                "value": "2"
              },
              "message": "lamaste-certbot rejects extra arguments (exit 2)"
            }
          }
        },
        {
          "id": "step-45",
          "label": "lamaste-certbot rejects a malformed email (exit 2)",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "var",
                "name": "BAD_EMAIL_RC"
              },
              "expected": {
                "kind": "literal",
                "value": "2"
              },
              "message": "lamaste-certbot rejects a malformed email (exit 2)"
            }
          }
        },
        {
          "id": "step-48",
          "label": "lamaste-cert-info rejects a traversing lineage name (exit 2)",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "var",
                "name": "TRAVERSAL_RC"
              },
              "expected": {
                "kind": "literal",
                "value": "2"
              },
              "message": "lamaste-cert-info rejects a traversing lineage name (exit 2)"
            }
          }
        },
        {
          "id": "step-49",
          "label": "Set PANEL_ENDDATE",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo -u lamaste sudo -n /usr/local/sbin/lamaste-cert-info \"panel.${WRAP_DOMAIN}\" enddate 2>/dev/null || echo \"\""
          },
          "capture": [
            {
              "variable": "PANEL_ENDDATE",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-50",
          "label": "lamaste-cert-info reads panel.${WRAP_DOMAIN}'s expiry",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "var",
                "name": "PANEL_ENDDATE"
              },
              "substring": {
                "kind": "literal",
                "value": "notAfter="
              },
              "message": "lamaste-cert-info reads panel.${WRAP_DOMAIN}'s expiry"
            }
          }
        },
        {
          "id": "step-51",
          "label": "Set ISSUES_TOTAL",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo grep -c ' certonly ' /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null || true"
          },
          "capture": [
            {
              "variable": "ISSUES_TOTAL",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-52",
          "label": "Set ISSUES_NAMED",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "sudo grep ' certonly ' /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | grep -c -- ' --cert-name ' || true"
          },
          "capture": [
            {
              "variable": "ISSUES_NAMED",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-53",
          "label": "Every certonly call carried --cert-name (${ISSUES_TOTAL} issued)",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "${ISSUES_NAMED:-0}"
              },
              "expected": {
                "kind": "var",
                "name": "ISSUES_TOTAL"
              },
              "message": "Every certonly call carried --cert-name (${ISSUES_TOTAL} issued)"
            }
          }
        },
        {
          "id": "step-54",
          "label": "No certonly calls recorded by the certbot shim yet",
          "target": "local",
          "op": {
            "type": "log",
            "level": "skip",
            "message": "No certonly calls recorded by the certbot shim yet"
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Sudoers: certbot and certificate reads via root-owned wrappers\"\n# ---------------------------------------------------------------------------\n\nSUDOERS_RULES=$(sudo grep -v '^[[:space:]]*#' /etc/sudoers.d/lamaste 2>/dev/null || echo \"\")\nassert_contains \"$SUDOERS_RULES\" \"NOPASSWD: /usr/local/sbin/lamaste-certbot\" \"sudoers allows the lamaste-certbot wrapper\" || true\nassert_contains \"$SUDOERS_RULES\" \"NOPASSWD: /usr/local/sbin/lamaste-cert-info\" \"sudoers allows the lamaste-cert-info wrapper\" || true\nassert_not_contains \"$SUDOERS_RULES\" \"/usr/bin/certbot\" \"sudoers has no direct certbot rule\" || true\nassert_not_contains \"$SUDOERS_RULES\" \"/etc/letsencrypt\" \"sudoers has no rule reaching into /etc/letsencrypt\" || true\n\nfor wrapper in lamaste-certbot lamaste-cert-info; do\n  WRAPPER_STAT=$(stat -c '%U %G %a' \"/usr/local/sbin/${wrapper}\" 2>/dev/null || echo \"missing\")\n  assert_eq \"$WRAPPER_STAT\" \"root root 755\" \"/usr/local/sbin/${wrapper} is root-owned 0755\" || true\ndone\n\n# The service user cannot run certbot directly, and the wrappers refuse any\n# argument beyond their fixed shapes (a trailing --deploy-hook would run code\n# as root; a traversing lineage would read any file)\nDIRECT_CERTBOT=$(sudo -u lamaste sudo -n /usr/bin/certbot certificates >/dev/null 2>&1 && echo allowed || echo denied)\nassert_eq \"$DIRECT_CERTBOT\" \"denied\" \"lamaste cannot run /usr/bin/certbot through sudo\" || true\nWRAP_DOMAIN=$(api_get \"onboarding/status\" | jq -r '.domain' 2>/dev/null || echo \"\")\nEXTRA_ARG_RC=0\nsudo -u lamaste sudo -n /usr/local/sbin/lamaste-certbot renew \"panel.${WRAP_DOMAIN}\" --deploy-hook /bin/true >/dev/null 2>&1 || EXTRA_ARG_RC=$?\nassert_eq \"$EXTRA_ARG_RC\" \"2\" \"lamaste-certbot rejects extra arguments (exit 2)\" || true\nBAD_EMAIL_RC=0\nsudo -u lamaste sudo -n /usr/local/sbin/lamaste-certbot issue \"-x@example.com\" \"panel.${WRAP_DOMAIN}\" \"panel.${WRAP_DOMAIN}\" >/dev/null 2>&1 || BAD_EMAIL_RC=$?\nassert_eq \"$BAD_EMAIL_RC\" \"2\" \"lamaste-certbot rejects a malformed email (exit 2)\" || true\nTRAVERSAL_RC=0\nsudo -u lamaste sudo -n /usr/local/sbin/lamaste-cert-info ../../../etc/shadow enddate >/dev/null 2>&1 || TRAVERSAL_RC=$?\nassert_eq \"$TRAVERSAL_RC\" \"2\" \"lamaste-cert-info rejects a traversing lineage name (exit 2)\" || true\nPANEL_ENDDATE=$(sudo -u lamaste sudo -n /usr/local/sbin/lamaste-cert-info \"panel.${WRAP_DOMAIN}\" enddate 2>/dev/null || echo \"\")\nassert_contains \"$PANEL_ENDDATE\" \"notAfter=\" \"lamaste-cert-info reads panel.${WRAP_DOMAIN}'s expiry\" || true\n\n# Every issue the panel ever made carried --cert-name (a fixed lineage name,\n# so a re-issue never drifts to <name>-0001)\nISSUES_TOTAL=$(sudo grep -c ' certonly ' /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null || true)\nISSUES_NAMED=$(sudo grep ' certonly ' /etc/letsencrypt/e2e-certbot-calls.log 2>/dev/null | grep -c -- ' --cert-name ' || true)\nif [ \"${ISSUES_TOTAL:-0}\" -gt 0 ] 2>/dev/null; then\n  assert_eq \"${ISSUES_NAMED:-0}\" \"${ISSUES_TOTAL}\" \"Every certonly call carried --cert-name (${ISSUES_TOTAL} issued)\" || true\nelse\n  log_skip \"No certonly calls recorded by the certbot shim yet\"\nfi"
    },
    {
      "id": "auto-renew-timer-status",
      "label": "Auto-renew timer status",
      "steps": [
        {
          "id": "step-55",
          "label": "GET /api/certs/auto-renew-status",
          "target": "host",
          "op": {
            "type": "api",
            "method": "GET",
            "path": "certs/auto-renew-status"
          },
          "capture": [
            {
              "variable": "AUTORENEW_RESPONSE",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-56",
          "label": "Extract AUTORENEW_ACTIVE",
          "target": "local",
          "op": {
            "type": "set",
            "variable": "AUTORENEW_ACTIVE",
            "from": {
              "kind": "jq",
              "input": {
                "kind": "var",
                "name": "AUTORENEW_RESPONSE"
              },
              "expression": ".active"
            }
          }
        },
        {
          "id": "step-57",
          "label": "Certbot auto-renew timer is active",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "Certbot auto-renew timer is active"
          },
          "when": {
            "kind": "var_eq",
            "variable": "AUTORENEW_ACTIVE",
            "value": "true"
          }
        },
        {
          "id": "step-58",
          "label": "Auto-renew has a next run time",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field_not_empty",
              "source": {
                "kind": "var",
                "name": "AUTORENEW_RESPONSE"
              },
              "path": ".nextRun",
              "message": "Auto-renew has a next run time"
            }
          },
          "when": {
            "kind": "var_eq",
            "variable": "AUTORENEW_ACTIVE",
            "value": "true"
          }
        },
        {
          "id": "step-60",
          "label": "Certbot auto-renew timer is not active (may need certbot.timer enabled)",
          "target": "local",
          "op": {
            "type": "log",
            "level": "info",
            "message": "Certbot auto-renew timer is not active (may need certbot.timer enabled)"
          },
          "when": {
            "kind": "var_eq",
            "variable": "AUTORENEW_ACTIVE",
            "value": "true"
          }
        },
        {
          "id": "step-61",
          "label": "Could not determine auto-renew timer status",
          "target": "local",
          "op": {
            "type": "log",
            "level": "fail",
            "message": "Could not determine auto-renew timer status"
          },
          "when": {
            "kind": "var_not_eq",
            "variable": "AUTORENEW_ACTIVE",
            "value": "true"
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Auto-renew timer status\"\n# ---------------------------------------------------------------------------\n\nAUTORENEW_RESPONSE=$(api_get \"certs/auto-renew-status\")\nAUTORENEW_ACTIVE=$(echo \"$AUTORENEW_RESPONSE\" | jq -r '.active' 2>/dev/null || echo \"null\")\n\nif [ \"$AUTORENEW_ACTIVE\" = \"true\" ]; then\n  log_pass \"Certbot auto-renew timer is active\"\n  assert_json_field_not_empty \"$AUTORENEW_RESPONSE\" '.nextRun' \"Auto-renew has a next run time\" || true\nelif [ \"$AUTORENEW_ACTIVE\" = \"false\" ]; then\n  log_info \"Certbot auto-renew timer is not active (may need certbot.timer enabled)\"\nelse\n  log_fail \"Could not determine auto-renew timer status\"\nfi"
    }
  ],
  "apiHelpers": [],
  "headerRaw": "# ============================================================================\n# 07 — Certificate Renewal\n# ============================================================================\n# Verifies certificate management:\n# - List certificates via GET /api/certs\n# - Force renew a certificate via POST /api/certs/:domain/renew\n# - Check auto-renew timer via GET /api/certs/auto-renew-status\n# - The panel reaches certbot and Let's Encrypt certificate reads only through\n#   the root-owned wrappers /usr/local/sbin/lamaste-certbot and\n#   /usr/local/sbin/lamaste-cert-info (sudoers has no certbot or\n#   /etc/letsencrypt openssl rule); the wrappers refuse extra arguments, and a\n#   panel renewal runs `certbot renew --cert-name <lineage> --force-renewal\n#   --no-random-sleep-on-renew --non-interactive` (checked in the E2E certbot\n#   shim's call log)\n#\n# NOTE: Certificate renewal requires real Let's Encrypt infrastructure.\n# Tests that call certbot are skipped when SKIP_DNS_TESTS=1.\n# ============================================================================",
  "preambleRaw": "\nset -euo pipefail\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nsource \"${SCRIPT_DIR}/helpers.sh\"\n\nrequire_commands curl jq\n\nbegin_test \"07 — Certificate Renewal\"\n",
  "cleanupRaw": "",
  "trailerRaw": "\nend_test\n"
}
