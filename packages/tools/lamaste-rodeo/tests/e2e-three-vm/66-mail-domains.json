{
  "version": 1,
  "meta": {
    "number": 66,
    "name": "Mail across domains: each portal its own reset link",
    "suite": "e2e-three-vm",
    "description": "66 — Mail across domains: each portal its own reset link (Three-VM)",
    "deps": [],
    "requires": ["multipass", "curl", "jq", "openssl"]
  },
  "env": {},
  "constants": {},
  "cleanup": [
    {
      "id": "cleanup-0",
      "label": "DELETE users/${USER_B}?erase=true",
      "target": "host",
      "continueOnError": true,
      "op": {
        "type": "api",
        "method": "DELETE",
        "path": "users/${USER_B}?erase=true"
      }
    },
    {
      "id": "cleanup-1",
      "label": "DELETE users/${USER_C}?erase=true",
      "target": "host",
      "continueOnError": true,
      "op": {
        "type": "api",
        "method": "DELETE",
        "path": "users/${USER_C}?erase=true"
      }
    }
  ],
  "sections": [
    {
      "id": "pre-flight",
      "label": "Pre-flight",
      "steps": [
        {
          "id": "step-4",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "md_api PUT \"domains/${DOMAIN_2}/language\" '{\"language\":\"tr\"}'"
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-5",
          "label": "B speaks Turkish",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "expr",
                "template": "$(body_of \"$RESP\")"
              },
              "path": ".domain.language",
              "expected": {
                "kind": "literal",
                "value": "tr"
              },
              "message": "B speaks Turkish"
            }
          }
        }
      ],
      "bash": "# ---------------------------------------------------------------------------\nlog_section \"Pre-flight\"\n# ---------------------------------------------------------------------------\n\nmd_preflight\nmail_cleanup\nmd_domain_active \"${DOMAIN_2}\"\nmd_domain_active \"${DOMAIN_3}\"\nRESP=$(md_api PUT \"domains/${DOMAIN_2}/language\" '{\"language\":\"tr\"}')\nassert_json_field \"$(body_of \"$RESP\")\" '.domain.language' 'tr' \"B speaks Turkish\" || true\nmail_sink_start\nmail_user \"${USER_B}\" \"[\\\"${DOMAIN_2}\\\"]\" \"${PASSWORD}\"\nmail_user \"${USER_C}\" \"[\\\"${DOMAIN_3}\\\"]\" \"${PASSWORD}\"\n\n# ===========================================================================\n# 1. B alone can send\n# ==========================================================================="
    },
    {
      "id": "b-s-own-transport-no-relay-transport",
      "label": "B's own transport, no relay transport",
      "steps": [
        {
          "id": "step-9",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_transport_put \"domains/${DOMAIN_2}/mail\" \"no-reply@notify.${DOMAIN_2}\" \"E2E B\""
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-10",
          "label": "PUT /api/domains/${DOMAIN_2}/mail: B's own transport to the sink",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(status_of \"$RESP\")"
              },
              "expected": {
                "kind": "literal",
                "value": "200"
              },
              "message": "PUT /api/domains/${DOMAIN_2}/mail: B's own transport to the sink"
            }
          }
        },
        {
          "id": "step-11",
          "label": "…a domain row of its own",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "expr",
                "template": "$(body_of \"$RESP\")"
              },
              "path": "\"\\(.transport.scope) \\(.transport.kind)\"",
              "expected": {
                "kind": "literal",
                "value": "domain smtp"
              },
              "message": "…a domain row of its own"
            }
          }
        },
        {
          "id": "step-12",
          "label": "The relay has no transport",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(host_api_get \"settings/mail\" | jq -c '.transport' 2>/dev/null)"
              },
              "expected": {
                "kind": "literal",
                "value": "null"
              },
              "message": "The relay has no transport"
            }
          }
        },
        {
          "id": "step-14",
          "label": "auth.${DOMAIN_2}/ links https://auth.${DOMAIN_2}/reset",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "auth.${DOMAIN_2}/ links https://auth.${DOMAIN_2}/reset"
          }
        },
        {
          "id": "step-15",
          "label": "auth.${DOMAIN_2}/: $(portal_index_reset \"${DOMAIN_2}\")",
          "target": "local",
          "op": {
            "type": "log",
            "level": "fail",
            "message": "auth.${DOMAIN_2}/: $(portal_index_reset \"${DOMAIN_2}\")"
          }
        },
        {
          "id": "step-16",
          "label": "auth.${DOMAIN}/ (cannot send) links no reset page",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(portal_index_reset \"${DOMAIN}\")"
              },
              "expected": {
                "kind": "literal",
                "value": "data-resetpasswordcustomurl=\"\""
              },
              "message": "auth.${DOMAIN}/ (cannot send) links no reset page"
            }
          }
        },
        {
          "id": "step-17",
          "label": "auth.${DOMAIN_3}/ (cannot send) links none",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(portal_index_reset \"${DOMAIN_3}\")"
              },
              "expected": {
                "kind": "literal",
                "value": "data-resetpasswordcustomurl=\"\""
              },
              "message": "auth.${DOMAIN_3}/ (cannot send) links none"
            }
          }
        },
        {
          "id": "step-18",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_portal_post \"${DOMAIN_3}\" /api/account/reset/start \"{\\\"identifier\\\":\\\"${USER_C}\\\"}\""
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-19",
          "label": "A reset on auth.${DOMAIN_3}: 404",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(visit_status \"$RESP\")"
              },
              "expected": {
                "kind": "literal",
                "value": "404"
              },
              "message": "A reset on auth.${DOMAIN_3}: 404"
            }
          }
        },
        {
          "id": "step-20",
          "label": "…reset_unavailable",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "expr",
                "template": "$(visit_body \"$RESP\")"
              },
              "path": ".code",
              "expected": {
                "kind": "literal",
                "value": "reset_unavailable"
              },
              "message": "…reset_unavailable"
            }
          }
        }
      ],
      "bash": "log_section \"B's own transport, no relay transport\"\n\nRESP=$(mail_transport_put \"domains/${DOMAIN_2}/mail\" \"no-reply@notify.${DOMAIN_2}\" \"E2E B\")\nassert_eq \"$(status_of \"$RESP\")\" \"200\" \"PUT /api/domains/${DOMAIN_2}/mail: B's own transport to the sink\" || true\nassert_json_field \"$(body_of \"$RESP\")\" '\"\\(.transport.scope) \\(.transport.kind)\"' 'domain smtp' \"…a domain row of its own\" || true\nassert_eq \"$(host_api_get \"settings/mail\" | jq -c '.transport' 2>/dev/null)\" \"null\" \"The relay has no transport\" || true\nmd_wait_authelia \"${DOMAIN}\"\nif wait_for 90 portal_links_reset \"${DOMAIN_2}\" \"https://auth.${DOMAIN_2}/reset\"; then\n  log_pass \"auth.${DOMAIN_2}/ links https://auth.${DOMAIN_2}/reset\"\nelse\n  log_fail \"auth.${DOMAIN_2}/: $(portal_index_reset \"${DOMAIN_2}\")\"\nfi\nassert_eq \"$(portal_index_reset \"${DOMAIN}\")\" 'data-resetpasswordcustomurl=\"\"' \"auth.${DOMAIN}/ (cannot send) links no reset page\" || true\nassert_eq \"$(portal_index_reset \"${DOMAIN_3}\")\" 'data-resetpasswordcustomurl=\"\"' \"auth.${DOMAIN_3}/ (cannot send) links none\" || true\nRESP=$(mail_portal_post \"${DOMAIN_3}\" /api/account/reset/start \"{\\\"identifier\\\":\\\"${USER_C}\\\"}\")\nassert_eq \"$(visit_status \"$RESP\")\" \"404\" \"A reset on auth.${DOMAIN_3}: 404\" || true\nassert_json_field \"$(visit_body \"$RESP\")\" '.code' 'reset_unavailable' \"…reset_unavailable\" || true"
    },
    {
      "id": "a-member-of-b-forgets-their-password-turkish-from-b-s-sender",
      "label": "A member of B forgets their password: Turkish, From B's sender",
      "steps": [
        {
          "id": "step-21",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_portal_post \"${DOMAIN_2}\" /api/account/reset/start \"{\\\"identifier\\\":\\\"${USER_B}@${MAIL_DOMAIN}\\\"}\""
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-22",
          "label": "POST auth.${DOMAIN_2}/api/account/reset/start (by address): 202",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(visit_status \"$RESP\")"
              },
              "expected": {
                "kind": "literal",
                "value": "202"
              },
              "message": "POST auth.${DOMAIN_2}/api/account/reset/start (by address): 202"
            }
          }
        },
        {
          "id": "step-24",
          "label": "Set MAIL",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_last_to \"${USER_B}@${MAIL_DOMAIN}\""
          },
          "capture": [
            {
              "variable": "MAIL",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-25",
          "label": "…From B's sender",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "var",
                "name": "MAIL"
              },
              "path": ".from",
              "expected": {
                "kind": "expr",
                "template": "no-reply@notify.${DOMAIN_2}"
              },
              "message": "…From B's sender"
            }
          }
        },
        {
          "id": "step-26",
          "label": "…in Turkish: Şifrenizi sıfırlayın",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "var",
                "name": "MAIL"
              },
              "path": ".subject",
              "expected": {
                "kind": "literal",
                "value": "Şifrenizi sıfırlayın"
              },
              "message": "…in Turkish: Şifrenizi sıfırlayın"
            }
          }
        },
        {
          "id": "step-27",
          "label": "…its link on auth.${DOMAIN_2}",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "expr",
                "template": "$(mail_link_in \"$MAIL\" \"/reset#\")"
              },
              "substring": {
                "kind": "expr",
                "template": "https://auth.${DOMAIN_2}/reset#"
              },
              "message": "…its link on auth.${DOMAIN_2}"
            }
          }
        },
        {
          "id": "step-28",
          "label": "…naming the username",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "contains",
              "actual": {
                "kind": "expr",
                "template": "$(json_get \"$MAIL\" '.text')"
              },
              "substring": {
                "kind": "var",
                "name": "USER_B"
              },
              "message": "…naming the username"
            }
          }
        }
      ],
      "bash": "log_section \"A member of B forgets their password: Turkish, From B's sender\"\n\nRESP=$(mail_portal_post \"${DOMAIN_2}\" /api/account/reset/start \"{\\\"identifier\\\":\\\"${USER_B}@${MAIL_DOMAIN}\\\"}\")\nassert_eq \"$(visit_status \"$RESP\")\" \"202\" \"POST auth.${DOMAIN_2}/api/account/reset/start (by address): 202\" || true\nmail_wait \"${USER_B}@${MAIL_DOMAIN}\" 1 \"The mail is in the sink\"\nMAIL=$(mail_last_to \"${USER_B}@${MAIL_DOMAIN}\")\nassert_json_field \"$MAIL\" '.from' \"no-reply@notify.${DOMAIN_2}\" \"…From B's sender\" || true\nassert_json_field \"$MAIL\" '.subject' 'Şifrenizi sıfırlayın' \"…in Turkish: Şifrenizi sıfırlayın\" || true\nassert_contains \"$(mail_link_in \"$MAIL\" \"/reset#\")\" \"https://auth.${DOMAIN_2}/reset#\" \"…its link on auth.${DOMAIN_2}\" || true\nassert_contains \"$(json_get \"$MAIL\" '.text')\" \"${USER_B}\" \"…naming the username\" || true\n\n# ===========================================================================\n# 2. The relay's transport too\n# ==========================================================================="
    },
    {
      "id": "the-relay-s-transport-added-every-portal-its-own-reset-link",
      "label": "The relay's transport added: every portal its own reset link",
      "steps": [
        {
          "id": "step-29",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_transport_put \"settings/mail\" \"no-reply@notify.${DOMAIN}\" \"E2E Relay\""
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-30",
          "label": "PUT /api/settings/mail: the relay's transport",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "eq",
              "actual": {
                "kind": "expr",
                "template": "$(status_of \"$RESP\")"
              },
              "expected": {
                "kind": "literal",
                "value": "200"
              },
              "message": "PUT /api/settings/mail: the relay's transport"
            }
          }
        },
        {
          "id": "step-33",
          "label": "auth.${D}/ links https://auth.${D}/reset",
          "target": "local",
          "op": {
            "type": "log",
            "level": "pass",
            "message": "auth.${D}/ links https://auth.${D}/reset"
          }
        },
        {
          "id": "step-34",
          "label": "auth.${D}/: $(portal_index_reset \"$D\")",
          "target": "local",
          "op": {
            "type": "log",
            "level": "fail",
            "message": "auth.${D}/: $(portal_index_reset \"$D\")"
          }
        },
        {
          "id": "step-36",
          "label": "Exec on host",
          "target": "host",
          "op": {
            "type": "exec",
            "command": "${AUTHELIA_CONFIG_JSON}"
          },
          "capture": [
            {
              "variable": "CONFIG",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-37",
          "label": "Authelia's one custom_url is the primary's; the vhosts give each portal its own",
          "target": "local",
          "continueOnError": true,
          "op": {
            "type": "assert",
            "check": {
              "kind": "json_field",
              "source": {
                "kind": "var",
                "name": "CONFIG"
              },
              "path": ".authentication_backend.password_reset.custom_url",
              "expected": {
                "kind": "expr",
                "template": "https://auth.${DOMAIN}/reset"
              },
              "message": "Authelia's one custom_url is the primary's; the vhosts give each portal its own"
            }
          }
        }
      ],
      "bash": "log_section \"The relay's transport added: every portal its own reset link\"\n\nRESP=$(mail_transport_put \"settings/mail\" \"no-reply@notify.${DOMAIN}\" \"E2E Relay\")\nassert_eq \"$(status_of \"$RESP\")\" \"200\" \"PUT /api/settings/mail: the relay's transport\" || true\nmd_wait_authelia \"${DOMAIN}\"\nfor D in \"${DOMAIN}\" \"${DOMAIN_2}\" \"${DOMAIN_3}\"; do\n  if wait_for 90 portal_links_reset \"$D\" \"https://auth.${D}/reset\"; then\n    log_pass \"auth.${D}/ links https://auth.${D}/reset\"\n  else\n    log_fail \"auth.${D}/: $(portal_index_reset \"$D\")\"\n  fi\ndone\nCONFIG=$(host_exec \"${AUTHELIA_CONFIG_JSON}\" 2>/dev/null | tail -n 1 || echo '{}')\nassert_json_field \"$CONFIG\" '.authentication_backend.password_reset.custom_url' \"https://auth.${DOMAIN}/reset\" \"Authelia's one custom_url is the primary's; the vhosts give each portal its own\" || true"
    },
