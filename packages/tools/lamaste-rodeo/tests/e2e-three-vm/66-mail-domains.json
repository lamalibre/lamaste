    {
      "id": "a-reset-for-a-member-of-b-asked-on-c-s-portal-no-mail",
      "label": "A reset for a member of B asked on C's portal: no mail",
      "steps": [
        {
          "id": "step-45",
          "label": "Set BEFORE",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_count_to \"${USER_B}@${MAIL_DOMAIN}\""
          },
          "capture": [
            {
              "variable": "BEFORE",
              "from": {
                "kind": "body"
              }
            }
          ]
        },
        {
          "id": "step-46",
          "label": "Set RESP",
          "target": "local",
          "op": {
            "type": "exec",
            "command": "mail_portal_post \"${DOMAIN_3}\" /api/account/reset/start \"{\\\"identifier\\\":\\\"${USER_B}\\\"}\""
          },
          "capture": [
            {
              "variable": "RESP",
              "from": {
