#!/usr/bin/node
/**
 * lamaste-priv — the root half of the Lamaste panel.
 *
 * The panel runs as the unprivileged `lamaste` user. Everything it must do as
 * root that is not a fixed command line goes through this one program, which
 * sudoers allows it to run (`/etc/sudoers.d/lamaste`). Each operation takes a
 * fixed, validated set of arguments; content (vhost text, TOTP secrets) comes
 * on stdin, never on the command line, so it is not written to the sudo log.
 *
 *   nginx-site write <name>            stdin: vhost text (validated, see below)
 *   nginx-site backup <name>           copy <name> to <name>.bak
 *   nginx-site restore <name>          move <name>.bak back to <name>
 *   nginx-site discard-backup <name>   delete <name>.bak
 *   nginx-site enable <name>           link <name> into sites-enabled
 *   nginx-site disable <name>          unlink <name> from sites-enabled
 *   nginx-site remove <name>           delete <name>, its link and its backup
 *   authelia-totp <username>           stdin: base32 secret
 *   authelia-user purge-second-factors <username>
 *                                      delete the user's TOTP configuration and
 *                                      every WebAuthn credential from Authelia's
 *                                      storage (nothing there is fine)
 *   authelia-user has-oidc-identifier <username>
 *                                      print `yes` when Authelia's storage holds an
 *                                      OpenID Connect opaque identifier for the
 *                                      username, `no` otherwise — nothing else
 *   self-update <version>              run create-lamaste@<version> detached
 *   hooks install <route> <sha256|none>  stdin: the plugin's approved relay hook
 *                                      module (none: shared hooks only); start its runner
 *   hooks activate <route> <sha256>    point the runner back at a module kept from before
 *   hooks restart <route>              stop the plugin's hook runner (the socket stays)
 *   hooks remove <route>               disable the runner and delete its modules
 *
 * Why vhosts are validated: nginx's master process runs as root and opens the
 * files a configuration names — `access_log /etc/cron.d/x` with a crafted
 * `log_format` is a root shell. A vhost is accepted only if every directive is
 * on the allow-list below, in the context it belongs to, with arguments that
 * cannot name a file outside the paths Lamaste serves. Anything else —
 * including a directive nginx would accept — is refused.
 *
 * This file is installed root-owned (0755) at /usr/local/sbin/lamaste-priv by
 * create-lamaste. It uses only Node.js built-ins and reads nothing the
 * lamaste user can write, so it cannot be steered by the panel's own files.
 * It is CommonJS on purpose: an extension-less script outside any package is
 * loaded as CommonJS by every supported Node.js version.
 */

'use strict';

const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { spawnSync } = require('node:child_process');

const SITES_AVAILABLE = '/etc/nginx/sites-available';
const SITES_ENABLED = '/etc/nginx/sites-enabled';
const MAX_VHOST_BYTES = 256 * 1024;

const AUTHELIA_BIN = '/usr/local/bin/authelia';
const AUTHELIA_CONFIG = '/etc/authelia/configuration.yml';
const AUTHELIA_USER = 'lamaste-authelia';
/**
 * Environment of every `authelia` CLI run. The configuration is a Go
 * template (it reads the OIDC issuer key with `{{ secret "…" }}`), so the
 * CLI needs the same filter the service unit sets, or it fails to parse
 * the file once an OIDC provider is configured.
 */
const AUTHELIA_CLI_ENV = Object.freeze({
  PATH: '/usr/bin:/bin',
  HOME: '/nonexistent',
  X_AUTHELIA_CONFIG_FILTERS: 'template',
});

const SYSTEMD_RUN = '/usr/bin/systemd-run';
const NPX = '/usr/bin/npx';

class UsageError extends Error {}

// ---------------------------------------------------------------------------
// Site names
// ---------------------------------------------------------------------------

const LABEL = '[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?';
/** A full hostname, lower case, two labels at least — what names a vhost since the multi-domain relay. */
const HOST = '[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+';
const UUID = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';

/**
 * Vhosts the panel writes: the panel's and chisel's (primary domain), one
 * auth portal per domain, a tunnel's by its full hostname, a site's by id.
 */
const PANEL_SITE_RE = new RegExp(
  `^lamalibre-lamaste-(?:panel-domain|tunnel|auth-${HOST}|app-${HOST}|agent-panel-${HOST}|site-${UUID})$`,
);

/**
 * Vhost names before the multi-domain relay — the auth portal and tunnels
 * by subdomain alone. The panel renames them at start; it may still link,
 * unlink, back up, restore and remove them, but never write one.
 */
const LEGACY_SITE_RE = new RegExp(`^lamalibre-lamaste-(?:auth|app-${LABEL}|agent-panel-${LABEL})$`);

/** Vhosts create-lamaste writes that the panel may only switch on and off. */
const TOGGLE_ONLY_SITES = new Set(['lamalibre-lamaste-panel-ip']);

/** The longest site name: a file name, with room for its `.bak`. */
const MAX_SITE_NAME = 250;

function assertSiteName(name, action) {
  if (typeof name !== 'string' || name.length > MAX_SITE_NAME) {
    throw new UsageError('invalid site name');
  }
  if (PANEL_SITE_RE.test(name)) return;
  if (action !== 'write' && LEGACY_SITE_RE.test(name)) return;
  if ((action === 'enable' || action === 'disable') && TOGGLE_ONLY_SITES.has(name)) return;
  throw new UsageError(`site name not allowed for ${action}: ${name}`);
}

// ---------------------------------------------------------------------------
// nginx configuration: tokenizer and parser
// ---------------------------------------------------------------------------

/**
 * Split nginx configuration text into tokens: words (quoted or bare), `{`,
 * `}` and `;`. Comments run from a `#` at the start of a token to the end of
 * the line, as in nginx.
 *
 * Anything whose meaning could differ between this tokenizer and nginx's is
 * refused rather than interpreted: backslashes, `${`, control characters, and
 * non-ASCII text outside comments.
 */
function tokenize(text) {
  const tokens = [];
  let i = 0;
  let line = 1;
  const n = text.length;
  const isSpace = (c) => c === ' ' || c === '\t' || c === '\r' || c === '\n';
  const fail = (msg) => {
    throw new UsageError(`vhost line ${line}: ${msg}`);
  };

  while (i < n) {
    const c = text[i];
    if (c === '\n') {
      line++;
      i++;
      continue;
    }
    if (isSpace(c)) {
      i++;
      continue;
    }
    if (c === '#') {
      while (i < n && text[i] !== '\n') i++;
      continue;
    }
    if (c === '{' || c === '}' || c === ';') {
      tokens.push({ type: c, line });
      i++;
      continue;
    }

    let value = '';
    let quoted = false;
    if (c === '"' || c === "'") {
      quoted = true;
      const quote = c;
      i++;
      for (;;) {
        if (i >= n) fail('unterminated quoted string');
        const d = text[i];
        if (d === quote) {
          i++;
          break;
        }
        if (d === '\n') fail('newline inside a quoted string');
        value += d;
        i++;
      }
      if (i < n && !isSpace(text[i]) && text[i] !== ';' && text[i] !== '{' && text[i] !== '}') {
        fail('unexpected character after a quoted string');
      }
    } else {
      while (i < n) {
        const d = text[i];
        if (isSpace(d) || d === ';' || d === '{' || d === '}') break;
        if (d === '"' || d === "'") fail('quote inside a word');
        value += d;
        i++;
      }
    }

    for (let k = 0; k < value.length; k++) {
      const code = value.charCodeAt(k);
      if (code < 0x20 || code > 0x7e) fail('non-printable or non-ASCII character');
    }
    if (value.includes('\\')) fail('backslash');
    if (value.includes('${')) fail('"${" variable syntax');
    tokens.push({ type: 'word', value, quoted, line });
  }
  return tokens;
}

/**
 * Parse tokens into directives: `{ name, args, block, line }`, where `block`
 * is an array of child directives or null for a simple directive.
 */
function parse(tokens) {
  let pos = 0;
  const parseBlock = (depth) => {
    const out = [];
    for (;;) {
      const t = tokens[pos];
      if (t === undefined) {
        if (depth > 0) throw new UsageError('vhost: unexpected end of file, missing "}"');
        return out;
      }
      if (t.type === '}') {
        if (depth === 0) throw new UsageError(`vhost line ${t.line}: unexpected "}"`);
        pos++;
        return out;
      }
      if (t.type !== 'word') {
        throw new UsageError(`vhost line ${t.line}: unexpected "${t.type}"`);
      }
      const name = t.value;
      const args = [];
      pos++;
      for (;;) {
        const a = tokens[pos];
        if (a === undefined)
          throw new UsageError(`vhost line ${t.line}: "${name}" is not terminated`);
        if (a.type === 'word') {
          args.push(a.value);
          pos++;
          continue;
        }
        if (a.type === ';') {
          pos++;
          out.push({ name, args, block: null, line: t.line });
          break;
        }
        if (a.type === '{') {
          if (depth >= 8) throw new UsageError(`vhost line ${t.line}: blocks nested too deeply`);
          pos++;
          const block = parseBlock(depth + 1);
          out.push({ name, args, block, line: t.line });
          break;
        }
        throw new UsageError(`vhost line ${a.line}: unexpected "}"`);
      }
    }
  };
  return parseBlock(0);
}

// ---------------------------------------------------------------------------
// nginx configuration: allow-list
// ---------------------------------------------------------------------------

const HOSTNAME_RE =
  /^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;
const CERT_FILE_RE =
  /^\/etc\/letsencrypt\/live\/[a-z0-9][a-z0-9.-]{0,252}\/(?:fullchain|privkey)\.pem$/;
const SNIPPET_RE = /^\/etc\/nginx\/snippets\/lamalibre-lamaste-[a-z0-9-]{1,64}\.conf$/;
const WEBROOT_RE = /^\/var\/www\/lamaste\/[A-Za-z0-9._/-]*$/;
const HEADER_NAME_RE = /^[A-Za-z0-9-]{1,64}$/;
const VARIABLE_RE = /^\$[A-Za-z_][A-Za-z0-9_]{0,63}$/;
const URI_PATH_RE = /^\/[A-Za-z0-9._~/-]*$/;
/** A named location (`location @previous`), the target of a try_files fallback. */
const NAMED_LOCATION_RE = /^@[a-z][a-z0-9_]{0,31}$/;
const TRY_FILES_ARG_RE = /^[A-Za-z0-9._/$=-]{1,256}$/;
/** A `types` entry: a media type, then the extensions served with it. */
const MEDIA_TYPE_RE = /^[a-z]+\/[a-z0-9.+-]{1,64}$/;
const EXTENSION_RE = /^[a-z0-9]{1,16}$/;

function hasDotDotSegment(p) {
  return p.split('/').some((seg) => seg === '..' || seg === '.');
}

function webrootPath(p) {
  return WEBROOT_RE.test(p) && !hasDotDotSegment(p);
}

const argc = (min, max) => (args) => args.length >= min && args.length <= max;
const each = (re) => (args) => args.length > 0 && args.every((a) => re.test(a));
const oneOf =
  (...values) =>
  (args) =>
    args.length === 1 && values.includes(args[0]);
const any = () => true;

/**
 * Directives allowed in each context, with a check of their arguments. A
 * directive not listed for its context is refused. `block: true` marks a
 * block directive and names the context of its children.
 */
const RULES = {
  // http{} level — the top of a sites-enabled file
  main: {
    server: { block: 'server', args: argc(0, 0) },
    map: { block: 'map', args: (a) => a.length === 2 && a.every((v) => VARIABLE_RE.test(v)) },
    limit_req_zone: {
      args: (a) =>
        a.length === 3 &&
        VARIABLE_RE.test(a[0]) &&
        /^zone=[a-z_]{1,32}:\d{1,4}[km]$/.test(a[1]) &&
        /^rate=\d{1,6}r\/[sm]$/.test(a[2]),
    },
  },
  server: {
    // Port 80 belongs to create-lamaste's HTTPS redirect and to certbot's
    // HTTP-01 challenges; panel vhosts serve TLS only.
    listen: {
      args: (a) =>
        a.length >= 1 &&
        /^(?:\[::\]:)?443$/.test(a[0]) &&
        a.slice(1).every((f) => f === 'ssl' || f === 'http2'),
    },
    server_name: { args: each(HOSTNAME_RE) },
    ssl_certificate: {
      args: (a) => a.length === 1 && CERT_FILE_RE.test(a[0]) && !hasDotDotSegment(a[0]),
    },
    ssl_certificate_key: {
      args: (a) => a.length === 1 && CERT_FILE_RE.test(a[0]) && !hasDotDotSegment(a[0]),
    },
    include: { args: (a) => a.length === 1 && SNIPPET_RE.test(a[0]) },
    ssl_protocols: { args: each(/^TLSv1\.[23]$/) },
    ssl_ciphers: { args: (a) => a.length === 1 && /^[A-Za-z0-9:!+@_-]{1,512}$/.test(a[0]) },
    ssl_prefer_server_ciphers: { args: oneOf('on', 'off') },
    client_max_body_size: { args: (a) => a.length === 1 && /^\d{1,6}[kKmMgG]?$/.test(a[0]) },
    root: { args: (a) => a.length === 1 && webrootPath(a[0]) },
    index: { args: each(/^[A-Za-z0-9._-]{1,64}$/) },
    add_header: {
      args: (a) =>
        (a.length === 2 || (a.length === 3 && a[2] === 'always')) && HEADER_NAME_RE.test(a[0]),
    },
    proxy_set_header: { args: (a) => a.length === 2 && HEADER_NAME_RE.test(a[0]) },
    error_page: { args: errorPageArgs },
    return: { args: argc(1, 2) },
    rewrite: { args: rewriteArgs },
    // A host whose every location asks the same authorization (a plugin's
    // web surface): a URI of this server, never a file.
    auth_request: { args: (a) => a.length === 1 && (a[0] === 'off' || URI_PATH_RE.test(a[0])) },
    location: { block: 'location', args: locationArgs },
  },
  location: {
    location: { block: 'location', args: locationArgs },
    if: { block: 'if', args: argc(1, 5) },
    // The content types of a plugin's web surface, named by the vhost
    // rather than the host's mime.types (entries checked below).
    types: { block: 'types', args: argc(0, 0) },
    internal: { args: argc(0, 0) },
    // The type of a body the location writes itself (a user surface's JSON
    // refusal): a media type, never a file.
    default_type: { args: (a) => a.length === 1 && /^[a-z]+\/[a-z0-9.+-]{1,64}$/.test(a[0]) },
    return: { args: argc(1, 2) },
    rewrite: { args: rewriteArgs },
    root: { args: (a) => a.length === 1 && webrootPath(a[0]) },
    alias: { args: (a) => a.length === 1 && webrootPath(a[0]) },
    index: { args: each(/^[A-Za-z0-9._-]{1,64}$/) },
    try_files: { args: tryFilesArgs },
    add_header: {
      args: (a) =>
        (a.length === 2 || (a.length === 3 && a[2] === 'always')) && HEADER_NAME_RE.test(a[0]),
    },
    error_page: { args: errorPageArgs },
    client_max_body_size: { args: (a) => a.length === 1 && /^\d{1,6}[kKmMgG]?$/.test(a[0]) },
    limit_req: {
      args: (a) =>
        a.length >= 1 &&
        a.length <= 3 &&
        /^zone=[a-z_]{1,32}$/.test(a[0]) &&
        a.slice(1).every((f) => /^burst=\d{1,6}$/.test(f) || f === 'nodelay'),
    },
    proxy_pass: {
      args: (a) =>
        a.length === 1 && /^http:\/\/127\.0\.0\.1:\d{1,5}(?:\/[A-Za-z0-9._~/-]*)?$/.test(a[0]),
    },
    proxy_set_header: { args: (a) => a.length === 2 && HEADER_NAME_RE.test(a[0]) },
    proxy_http_version: { args: oneOf('1.0', '1.1') },
    proxy_read_timeout: { args: (a) => a.length === 1 && /^\d{1,7}[smhd]?$/.test(a[0]) },
    proxy_send_timeout: { args: (a) => a.length === 1 && /^\d{1,7}[smhd]?$/.test(a[0]) },
    proxy_buffers: {
      args: (a) => a.length === 2 && /^\d{1,4}$/.test(a[0]) && /^\d{1,6}[kKmM]?$/.test(a[1]),
    },
    proxy_next_upstream: {
      args: each(
        /^(?:error|timeout|invalid_header|http_(?:500|502|503|504|403|404|429)|non_idempotent|off)$/,
      ),
    },
    proxy_pass_request_body: { args: oneOf('on', 'off') },
    auth_request: { args: (a) => a.length === 1 && (a[0] === 'off' || URI_PATH_RE.test(a[0])) },
    auth_request_set: { args: (a) => a.length === 2 && VARIABLE_RE.test(a[0]) },
    // The auth portal's rewrite of Authelia's index HTML for a domain's
    // brand (two literal strings; see subFilterArgs).
    sub_filter: { args: subFilterArgs },
    sub_filter_once: { args: oneOf('on', 'off') },
  },
  if: {
    return: { args: argc(1, 2) },
    rewrite: { args: rewriteArgs },
  },
};

function errorPageArgs(a) {
  if (a.length < 2) return false;
  let k = 0;
  while (k < a.length - 1 && /^\d{3}$/.test(a[k])) k++;
  if (k === 0) return false;
  if (k < a.length - 1 && /^=\d{0,3}$/.test(a[k])) k++;
  return k === a.length - 1;
}

function rewriteArgs(a) {
  return (
    (a.length === 2 ||
      (a.length === 3 && ['last', 'break', 'redirect', 'permanent'].includes(a[2]))) &&
    a[0].length <= 512 &&
    a[1].length <= 512
  );
}

/**
 * `sub_filter <string> <replacement>`: exactly two arguments of 1–512
 * bytes. Neither may name a variable: nginx expands `$name` in both (the
 * replacement always, the string since 1.9.4), which would put request data
 * into the page — the generator writes literal attribute strings only.
 * Newlines and control characters cannot reach here (the tokenizer refuses
 * them), nor can backslashes or `${`.
 */
const SUB_FILTER_MAX_BYTES = 512;
function subFilterArgs(a) {
  return (
    a.length === 2 &&
    a.every((v) => v.length >= 1 && v.length <= SUB_FILTER_MAX_BYTES && !v.includes('$'))
  );
}

/** Files to try under the location's root; the last may instead name a location. */
function tryFilesArgs(a) {
  if (a.length === 0) return false;
  const last = a[a.length - 1];
  return (
    a.slice(0, -1).every((v) => TRY_FILES_ARG_RE.test(v)) &&
    (TRY_FILES_ARG_RE.test(last) || NAMED_LOCATION_RE.test(last))
  );
}

function locationArgs(a) {
  if (a.length === 1) {
    return (a[0].length <= 512 && a[0].startsWith('/')) || NAMED_LOCATION_RE.test(a[0]);
  }
  return a.length === 2 && ['=', '~', '~*', '^~'].includes(a[0]) && a[1].length <= 512;
}

function validateDirectives(directives, context) {
  const rules = RULES[context];
  for (const d of directives) {
    if (context === 'map') {
      // map entries are "key value;" pairs. `include` inside a map reads a
      // file (as root) into the map's values — refused, like any block.
      if (d.block !== null) throw new UsageError(`vhost line ${d.line}: block inside map`);
      if (d.name === 'include') throw new UsageError(`vhost line ${d.line}: include inside map`);
      if (
        d.args.length !== 1 &&
        !(d.args.length === 0 && ['hostnames', 'volatile'].includes(d.name))
      ) {
        throw new UsageError(`vhost line ${d.line}: malformed map entry`);
      }
      continue;
    }
    if (context === 'types') {
      // types entries are "media/type ext...;" — no block, no include.
      if (d.block !== null) throw new UsageError(`vhost line ${d.line}: block inside types`);
      if (!MEDIA_TYPE_RE.test(d.name) || !each(EXTENSION_RE)(d.args)) {
        throw new UsageError(`vhost line ${d.line}: malformed types entry`);
      }
      continue;
    }
    const rule = rules[d.name];
    if (!rule) {
      throw new UsageError(
        `vhost line ${d.line}: directive "${d.name}" is not allowed in ${context}`,
      );
    }
    if (!rule.args(d.args)) {
      throw new UsageError(`vhost line ${d.line}: arguments of "${d.name}" are not allowed`);
    }
    if (rule.block) {
      if (d.block === null) throw new UsageError(`vhost line ${d.line}: "${d.name}" needs a block`);
      validateDirectives(d.block, rule.block);
    } else if (d.block !== null) {
      throw new UsageError(`vhost line ${d.line}: "${d.name}" takes no block`);
    }
  }
}

/** Throws UsageError unless `text` is a vhost Lamaste may install. */
function validateVhost(text) {
  if (Buffer.byteLength(text, 'utf8') > MAX_VHOST_BYTES) {
    throw new UsageError('vhost is too large');
  }
  // Comments may carry any text; strip them before the ASCII checks by
  // letting the tokenizer skip them.
  const directives = parse(tokenize(text));
  if (directives.length === 0) throw new UsageError('vhost is empty');
  validateDirectives(directives, 'main');
}

// ---------------------------------------------------------------------------
// Filesystem helpers (all paths are in root-owned directories)
// ---------------------------------------------------------------------------

function fsyncDir(dir) {
  const fd = fs.openSync(dir, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY);
  try {
    fs.fsyncSync(fd);
  } finally {
    fs.closeSync(fd);
  }
}

/** Atomically replace `dest` with `content` (temp file, fsync, rename). */
function atomicWrite(dest, content, mode) {
  const dir = path.dirname(dest);
  const tmp = path.join(dir, `.lamaste-priv-${crypto.randomBytes(8).toString('hex')}`);
  const fd = fs.openSync(
    tmp,
    fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW,
    mode,
  );
  try {
    fs.writeSync(fd, content);
    fs.fchmodSync(fd, mode);
    fs.fsyncSync(fd);
  } catch (err) {
    fs.closeSync(fd);
    fs.rmSync(tmp, { force: true });
    throw err;
  }
  fs.closeSync(fd);
  try {
    fs.renameSync(tmp, dest);
  } catch (err) {
    fs.rmSync(tmp, { force: true });
    throw err;
  }
  fsyncDir(dir);
}

function unlinkIfPresent(p) {
  try {
    fs.unlinkSync(p);
    return true;
  } catch (err) {
    if (err.code === 'ENOENT') return false;
    throw err;
  }
}

function isRegularFile(p) {
  try {
    return fs.lstatSync(p).isFile();
  } catch (err) {
    if (err.code === 'ENOENT') return false;
    throw err;
  }
}

function readStdinBytes(maxBytes) {
  const chunks = [];
  let total = 0;
  const buf = Buffer.alloc(65536);
  for (;;) {
    let read;
    try {
      read = fs.readSync(0, buf, 0, buf.length, null);
    } catch (err) {
      if (err.code === 'EAGAIN') continue;
      if (err.code === 'EOF') break;
      throw err;
    }
    if (read === 0) break;
    total += read;
    if (total > maxBytes) throw new UsageError('input is too large');
    chunks.push(Buffer.from(buf.subarray(0, read)));
  }
  return Buffer.concat(chunks);
}

function readStdin(maxBytes) {
  return readStdinBytes(maxBytes).toString('utf8');
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

function nginxSite(action, name) {
  assertSiteName(name, action);
  const available = path.join(SITES_AVAILABLE, name);
  const enabled = path.join(SITES_ENABLED, name);
  const backup = `${available}.bak`;

  switch (action) {
    case 'write': {
      const text = readStdin(MAX_VHOST_BYTES + 1);
      validateVhost(text);
      atomicWrite(available, text, 0o644);
      return;
    }
    case 'backup': {
      if (!isRegularFile(available)) throw new UsageError(`${name} does not exist`);
      atomicWrite(backup, fs.readFileSync(available), 0o644);
      return;
    }
    case 'restore': {
      if (!isRegularFile(backup)) throw new UsageError(`${name} has no backup`);
      fs.renameSync(backup, available);
      fsyncDir(SITES_AVAILABLE);
      return;
    }
    case 'discard-backup':
      unlinkIfPresent(backup);
      return;
    case 'enable': {
      if (!isRegularFile(available)) throw new UsageError(`${name} does not exist`);
      const tmp = path.join(
        SITES_ENABLED,
        `.lamaste-priv-${crypto.randomBytes(8).toString('hex')}`,
      );
      fs.symlinkSync(available, tmp);
      try {
        fs.renameSync(tmp, enabled);
      } catch (err) {
        unlinkIfPresent(tmp);
        throw err;
      }
      fsyncDir(SITES_ENABLED);
      return;
    }
    case 'disable':
      unlinkIfPresent(enabled);
      return;
    case 'remove':
      unlinkIfPresent(enabled);
      unlinkIfPresent(available);
      unlinkIfPresent(backup);
      return;
    default:
      throw new UsageError(`unknown nginx-site action: ${action}`);
  }
}

function lookupId(flag, name) {
  const result = spawnSync('/usr/bin/id', [flag, name], { encoding: 'utf8', env: {} });
  const id = Number.parseInt((result.stdout || '').trim(), 10);
  if (result.status !== 0 || !Number.isInteger(id) || id <= 0) {
    throw new Error(`user ${name} does not exist — run create-lamaste to repair the installation`);
  }
  return id;
}

/** Same shape as the panel's username schema; a leading "-" would read as a flag. */
const AUTHELIA_USERNAME_RE = /^[a-z0-9_][a-z0-9_-]{1,31}$/;

function assertAutheliaUsername(username) {
  if (typeof username !== 'string' || !AUTHELIA_USERNAME_RE.test(username)) {
    throw new UsageError('invalid username');
  }
}

/**
 * Store a TOTP secret in Authelia's database with Authelia's own CLI, run as
 * the Authelia service user (the database is its file).
 */
function autheliaTotp(username) {
  assertAutheliaUsername(username);
  const secret = readStdin(1024).trim();
  if (!/^[A-Z2-7]{16,128}$/.test(secret)) throw new UsageError('invalid TOTP secret');

  const result = runAutheliaCli(
    [
      'storage',
      'user',
      'totp',
      'generate',
      '--secret',
      secret,
      '--force',
      '--issuer',
      'Lamaste',
      '--algorithm',
      'SHA1',
      '--digits',
      '6',
      '--period',
      '30',
    ],
    username,
  );
  if (result.status !== 0) {
    // Authelia's error output does not echo the secret; its success output
    // (a QR code / otpauth URI) does, so only failures are relayed.
    throw new Error(
      `authelia exited with status ${result.status}: ${(result.stderr || '').trim()}`,
    );
  }
}

// ---------------------------------------------------------------------------
// Authelia's per-user storage
// ---------------------------------------------------------------------------

/**
 * Run `authelia <args> --config <config> [-- <username>]` as the Authelia
 * service account, with the environment the service has (its storage
 * encryption key comes from the configuration).
 * Opening the database as root would leave root-owned journal files the
 * service cannot write.
 */
function runAutheliaCli(args, username) {
  const uid = lookupId('-u', AUTHELIA_USER);
  const gid = lookupId('-g', AUTHELIA_USER);
  const result = spawnSync(
    AUTHELIA_BIN,
    [...args, '--config', AUTHELIA_CONFIG, ...(username === undefined ? [] : ['--', username])],
    {
      uid,
      gid,
      cwd: '/',
      env: { ...AUTHELIA_CLI_ENV },
      encoding: 'utf8',
      timeout: 60_000,
    },
  );
  if (result.error) throw result.error;
  return result;
}

/** Everything Authelia printed, to match a known refusal in. */
function cliOutput(result) {
  return `${result.stderr || ''}\n${result.stdout || ''}`;
}

/** Authelia's output with the username taken out: what this helper says may end up in a log. */
function redacted(text, username) {
  return String(text || '')
    .trim()
    .split(username)
    .join('<username>');
}

/**
 * Delete the user's TOTP configuration and every WebAuthn credential from
 * Authelia's storage. Authelia 4.39 refuses to delete a TOTP configuration
 * that does not exist (`no TOTP configuration for user`), which here means
 * there is nothing to delete; deleting WebAuthn credentials by username
 * succeeds whatever number there are.
 */
function autheliaPurgeSecondFactors(username) {
  assertAutheliaUsername(username);
  const totp = runAutheliaCli(['storage', 'user', 'totp', 'delete'], username);
  if (totp.status !== 0 && !/no TOTP configuration for user/.test(cliOutput(totp))) {
    throw new Error(
      `authelia storage user totp delete exited with status ${totp.status}: ${redacted(totp.stderr, username)}`,
    );
  }
  const webauthn = runAutheliaCli(['storage', 'user', 'webauthn', 'delete', '--all'], username);
  if (webauthn.status !== 0) {
    throw new Error(
      `authelia storage user webauthn delete exited with status ${webauthn.status}: ${redacted(webauthn.stderr, username)}`,
    );
  }
}

/** A YAML scalar as yaml.v3 writes a username: plain, or quoted when it would read as another type. */
function yamlScalar(text) {
  const value = text.trim();
  if (value.length >= 2 && value.startsWith('"') && value.endsWith('"')) {
    try {
      return JSON.parse(value);
    } catch {
      return null;
    }
  }
  if (value.length >= 2 && value.startsWith("'") && value.endsWith("'")) {
    return value.slice(1, -1).split("''").join("'");
  }
  return value;
}

/**
 * Whether the YAML of `authelia storage user identifiers export` (a list of
 * `{ service, sector_id, username, identifier }` under `identifiers`) names
 * `username`.
 */
function exportNamesUsername(text, username) {
  for (const line of String(text).split('\n')) {
    const match = /^\s*(?:-\s+)?username:(.*)$/.exec(line);
    if (match && yamlScalar(match[1]) === username) return true;
  }
  return false;
}

/** Overwrite a file with zeros, flush it, and remove it. */
function shred(file) {
  let fd = null;
  try {
    fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_NOFOLLOW);
    const { size } = fs.fstatSync(fd);
    const zeros = Buffer.alloc(Math.min(size, 65536));
    for (let written = 0; written < size; written += zeros.length) {
      fs.writeSync(fd, zeros, 0, Math.min(zeros.length, size - written), written);
    }
    fs.fsyncSync(fd);
  } catch (err) {
    if (err.code !== 'ENOENT') throw err;
  } finally {
    if (fd !== null) fs.closeSync(fd);
  }
  unlinkIfPresent(file);
}

/** The largest export read back: well beyond any opaque identifier table Lamaste serves. */
const MAX_IDENTIFIERS_EXPORT_BYTES = 32 * 1024 * 1024;

/**
 * Whether Authelia's storage holds an OpenID Connect opaque identifier for
 * the username. Authelia's CLI has no lookup by username, so it exports the
 * table (as the Authelia account) into a directory only that account and
 * root can enter, on /run (memory, not disk); the file is read, checked,
 * overwritten and removed, whatever happens. Prints `yes` or `no`.
 */
function autheliaHasOidcIdentifier(username) {
  assertAutheliaUsername(username);
  const uid = lookupId('-u', AUTHELIA_USER);
  const gid = lookupId('-g', AUTHELIA_USER);
  const dir = fs.mkdtempSync('/run/lamaste-priv-oidc-');
  const file = path.join(dir, 'identifiers.yml');
  try {
    fs.chmodSync(dir, 0o700);
    fs.chownSync(dir, uid, gid);
    const result = runAutheliaCli(['storage', 'user', 'identifiers', 'export', '--file', file]);
    if (result.status !== 0) {
      // An empty table is not an export.
      if (/no data to export/.test(cliOutput(result))) {
        process.stdout.write('no\n');
        return;
      }
      throw new Error(
        `authelia storage user identifiers export exited with status ${result.status}: ${redacted(result.stderr, username)}`,
      );
    }
    const st = fs.lstatSync(file);
    if (!st.isFile() || st.uid !== uid)
      throw new Error('the export is not the file Authelia wrote');
    if (st.size > MAX_IDENTIFIERS_EXPORT_BYTES) throw new Error('the export is too large');
    const named = exportNamesUsername(fs.readFileSync(file, 'utf8'), username);
    process.stdout.write(named ? 'yes\n' : 'no\n');
  } finally {
    shred(file);
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

const AUTHELIA_USER_ACTIONS = new Set(['purge-second-factors', 'has-oidc-identifier']);

/** `authelia-user <action> <username>`, checked before anything runs. */
function parseAutheliaUserArgs(rest) {
  if (rest.length !== 2) {
    throw new UsageError(
      'usage: authelia-user purge-second-factors|has-oidc-identifier <username>',
    );
  }
  const [action, username] = rest;
  if (!AUTHELIA_USER_ACTIONS.has(action)) {
    throw new UsageError(`unknown authelia-user action: ${String(action).slice(0, 40)}`);
  }
  assertAutheliaUsername(username);
  return { action, username };
}

function autheliaUser(rest) {
  const { action, username } = parseAutheliaUserArgs(rest);
  if (action === 'purge-second-factors') autheliaPurgeSecondFactors(username);
  else autheliaHasOidcIdentifier(username);
}

/**
 * Start `create-lamaste@<version> --yes` (the redeploy path) in a transient
 * systemd unit, two seconds from now: it stops and restarts the panel, so it
 * must not run inside the panel's service, and the delay lets the panel's
 * HTTP response reach the browser first.
 */
function selfUpdate(version) {
  if (typeof version !== 'string' || !/^\d{1,4}\.\d{1,4}\.\d{1,6}$/.test(version)) {
    throw new UsageError('version must be MAJOR.MINOR.PATCH');
  }
  const unit = `lamalibre-lamaste-update-${crypto.randomBytes(8).toString('hex')}`;
  const result = spawnSync(
    SYSTEMD_RUN,
    [
      '--unit',
      unit,
      '--description',
      `Lamaste update to ${version}`,
      '--on-active=2',
      '--timer-property=AccuracySec=100ms',
      '--property=Type=oneshot',
      '--setenv=HOME=/root',
      NPX,
      '--yes',
      `@lamalibre/create-lamaste@${version}`,
      '--yes',
    ],
    { cwd: '/', env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin' }, encoding: 'utf8', timeout: 30_000 },
  );
  if (result.error) throw result.error;
  if (result.status !== 0) {
    throw new Error(
      `systemd-run exited with status ${result.status}: ${(result.stderr || '').trim()}`,
    );
  }
  process.stdout.write(`${unit}\n`);
}

// ---------------------------------------------------------------------------
// Relay hook runners
// ---------------------------------------------------------------------------

const HOOKS_DIR = '/opt/lamalibre/lamaste/hooks';
const HOOKS_UNIT_PREFIX = 'lamalibre-lamaste-hooks';
const SYSTEMCTL = '/usr/bin/systemctl';
const HOOK_ROUTE_RE = /^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$/;
const SHA256_RE = /^[a-f0-9]{64}$/;
const MAX_HOOK_MODULE_BYTES = 4 * 1024 * 1024;

function assertHookRoute(route) {
  if (typeof route !== 'string' || !HOOK_ROUTE_RE.test(route)) {
    throw new UsageError('invalid plugin route');
  }
}

function assertSha256(digest) {
  if (typeof digest !== 'string' || !SHA256_RE.test(digest)) {
    throw new UsageError('digest must be a SHA-256 hex string');
  }
}

/** Create `dir` (0755, root) unless it exists; refuse anything but a root-owned directory. */
function ensureRootDirectory(dir) {
  try {
    fs.mkdirSync(dir, { mode: 0o755 });
  } catch (err) {
    if (err.code !== 'EEXIST') throw err;
  }
  const st = fs.lstatSync(dir);
  if (!st.isDirectory() || st.uid !== 0) {
    throw new Error(`${dir} is not a root-owned directory`);
  }
}

function sha256(bytes) {
  return crypto.createHash('sha256').update(bytes).digest('hex');
}

function systemctl(args, { allowFailure = false } = {}) {
  const result = spawnSync(SYSTEMCTL, args, {
    cwd: '/',
    env: { PATH: '/usr/sbin:/usr/bin:/sbin:/bin' },
    encoding: 'utf8',
    timeout: 30_000,
  });
  if (result.error) throw result.error;
  if (result.status !== 0 && !allowFailure) {
    throw new Error(
      `systemctl ${args.join(' ')} exited with status ${result.status}: ${(result.stderr || '').trim()}`,
    );
  }
}

function runnerEnvPath(route) {
  return path.join(HOOKS_DIR, route, 'runner.env');
}

/** The module the runner currently loads (from runner.env), or null. */
function activeHookModule(route) {
  let text;
  try {
    text = fs.readFileSync(runnerEnvPath(route), 'utf8');
  } catch (err) {
    if (err.code === 'ENOENT') return null;
    throw err;
  }
  const m = /^LAMASTE_HOOK_RUNNER_ARGS=--entry (\S+)$/m.exec(text);
  return m ? m[1] : null;
}

/**
 * runner.env: the node flag that lets the runner read the module, and the
 * runner flag that names it. Both empty when the plugin uses shared hooks
 * only. Paths are built here, never taken from the caller.
 */
function writeRunnerEnv(route, modulePath) {
  const nodeArgs = modulePath ? `--allow-fs-read=${modulePath}` : '';
  const runnerArgs = modulePath ? `--entry ${modulePath}` : '';
  atomicWrite(
    runnerEnvPath(route),
    `# Managed by lamaste-priv: the approved relay hook module of plugin ${route}.\n` +
      `LAMASTE_HOOK_NODE_ARGS=${nodeArgs}\nLAMASTE_HOOK_RUNNER_ARGS=${runnerArgs}\n`,
    0o644,
  );
}

/** Keep the active module and the one before it (for `hooks activate`); delete the rest. */
function pruneHookModules(route, keep) {
  const dir = path.join(HOOKS_DIR, route);
  for (const name of fs.readdirSync(dir)) {
    if (!/^[a-f0-9]{64}\.mjs$/.test(name)) continue;
    const file = path.join(dir, name);
    if (!keep.includes(file)) unlinkIfPresent(file);
  }
}

function restartRunner(route) {
  // The socket stays; the next call starts a runner with the new module.
  systemctl(['stop', `${HOOKS_UNIT_PREFIX}@${route}.service`]);
}

function hooksInstall(route, digest) {
  assertHookRoute(route);
  if (digest !== 'none') assertSha256(digest);
  ensureRootDirectory(HOOKS_DIR);
  ensureRootDirectory(path.join(HOOKS_DIR, route));
  const previous = activeHookModule(route);

  let modulePath = null;
  if (digest !== 'none') {
    const bytes = readStdinBytes(MAX_HOOK_MODULE_BYTES);
    if (bytes.length === 0) throw new UsageError('the hook module arrives on stdin');
    if (sha256(bytes) !== digest) {
      throw new Error('the hook module does not match the approved digest');
    }
    modulePath = path.join(HOOKS_DIR, route, `${digest}.mjs`);
    if (!isRegularFile(modulePath) || sha256(fs.readFileSync(modulePath)) !== digest) {
      atomicWrite(modulePath, bytes, 0o644);
    }
  }
  writeRunnerEnv(route, modulePath);
  pruneHookModules(route, [modulePath, previous].filter(Boolean));
  systemctl(['enable', '--now', `${HOOKS_UNIT_PREFIX}@${route}.socket`]);
  restartRunner(route);
}

function hooksActivate(route, digest) {
  assertHookRoute(route);
  assertSha256(digest);
  const modulePath = path.join(HOOKS_DIR, route, `${digest}.mjs`);
  if (!isRegularFile(modulePath) || sha256(fs.readFileSync(modulePath)) !== digest) {
    throw new Error('no kept hook module has that digest');
  }
  const previous = activeHookModule(route);
  writeRunnerEnv(route, modulePath);
  pruneHookModules(route, [modulePath, previous].filter(Boolean));
  systemctl(['enable', '--now', `${HOOKS_UNIT_PREFIX}@${route}.socket`]);
  restartRunner(route);
}

function hooksRestart(route) {
  assertHookRoute(route);
  restartRunner(route);
}

function hooksRemove(route) {
  assertHookRoute(route);
  systemctl(['disable', '--now', `${HOOKS_UNIT_PREFIX}@${route}.socket`], { allowFailure: true });
  systemctl(['stop', `${HOOKS_UNIT_PREFIX}@${route}.service`], { allowFailure: true });
  const dir = path.join(HOOKS_DIR, route);
  let st = null;
  try {
    st = fs.lstatSync(dir);
  } catch (err) {
    if (err.code !== 'ENOENT') throw err;
  }
  if (st) {
    if (!st.isDirectory() || st.uid !== 0) throw new Error(`${dir} is not a root-owned directory`);
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

function hooks(action, rest) {
  switch (action) {
    case 'install':
      if (rest.length !== 2) throw new UsageError('usage: hooks install <route> <sha256|none>');
      hooksInstall(rest[0], rest[1]);
      return;
    case 'activate':
      if (rest.length !== 2) throw new UsageError('usage: hooks activate <route> <sha256>');
      hooksActivate(rest[0], rest[1]);
      return;
    case 'restart':
      if (rest.length !== 1) throw new UsageError('usage: hooks restart <route>');
      hooksRestart(rest[0]);
      return;
    case 'remove':
      if (rest.length !== 1) throw new UsageError('usage: hooks remove <route>');
      hooksRemove(rest[0]);
      return;
    default:
      throw new UsageError(`unknown hooks action: ${action ?? '(none)'}`);
  }
}

function main(argv) {
  if (typeof process.getuid !== 'function' || process.getuid() !== 0) {
    throw new UsageError('must run as root (via sudo)');
  }
  process.umask(0o022);
  const [op, ...rest] = argv;
  switch (op) {
    case 'nginx-site':
      if (rest.length !== 2) throw new UsageError('usage: nginx-site <action> <name>');
      nginxSite(rest[0], rest[1]);
      return;
    case 'authelia-totp':
      if (rest.length !== 1) throw new UsageError('usage: authelia-totp <username>');
      autheliaTotp(rest[0]);
      return;
    case 'authelia-user':
      autheliaUser(rest);
      return;
    case 'self-update':
      if (rest.length !== 1) throw new UsageError('usage: self-update <version>');
      selfUpdate(rest[0]);
      return;
    case 'hooks':
      if (rest.length < 1) throw new UsageError('usage: hooks <action> <route> [...]');
      hooks(rest[0], rest.slice(1));
      return;
    default:
      throw new UsageError(`unknown operation: ${op ?? '(none)'}`);
  }
}

if (require.main === module) {
  try {
    main(process.argv.slice(2));
  } catch (err) {
    process.stderr.write(`lamaste-priv: ${err instanceof Error ? err.message : String(err)}\n`);
    process.exit(err instanceof UsageError ? 2 : 1);
  }
} else {
  module.exports = {
    validateVhost,
    tokenize,
    parse,
    assertSiteName,
    PANEL_SITE_RE,
    UsageError,
    AUTHELIA_CLI_ENV,
    assertHookRoute,
    HOOK_ROUTE_RE,
    assertAutheliaUsername,
    parseAutheliaUserArgs,
    exportNamesUsername,
    main,
  };
}
